# FiftyList Environment Variables
# Copy this file to .env and add your actual API keys

# TMDB API Key for movie search
# Get your free API key at: https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Google Books API (optional; avoids 429 on preload / online book search)
# https://console.cloud.google.com/apis/library/books.googleapis.com
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# RevenueCat public SDK keys (add when ready)
# iOS key format usually starts with: appl_
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_revenuecat_ios_public_sdk_key
# Android key format usually starts with: goog_
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_public_sdk_key
# Entitlement identifiers configured in RevenueCat dashboard
EXPO_PUBLIC_REVENUECAT_ENTRY_ENTITLEMENT_ID=entry
EXPO_PUBLIC_REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium
# Package identifiers in current offering (monthly packages)
EXPO_PUBLIC_REVENUECAT_ENTRY_PACKAGE_ID=entry_monthly
EXPO_PUBLIC_REVENUECAT_PREMIUM_PACKAGE_ID=premium_monthly

# Premium LLM proxy configuration
# Keep provider keys on your backend, not in the app.
# fiftylist-llm-proxy: enable Workers AI in wrangler (`ai` binding); no OpenAI API keys in the app.
EXPO_PUBLIC_ENABLE_LLM_ASSIST=false
EXPO_PUBLIC_LLM_PROXY_BASE_URL=https://your-backend.example.com
# For EAS production builds: set EXPO_PUBLIC_LLM_PROXY_BASE_URL in the Expo project
# (Environment variables → Production). eas.json enables EXPO_PUBLIC_ENABLE_LLM_ASSIST for production builds.
