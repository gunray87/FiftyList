{
  "expo": {
    "name": "FiftyList",
    "slug": "bolt-expo-nativewind",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fiftylist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D6B588"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.chrisgunn.fiftylist",
      "buildNumber": "23",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app may access your camera for features provided by third-party libraries. The camera is not used unless you choose a feature that requires it.",
        "CFBundleDisplayName": "FiftyList",
        "CFBundleName": "FiftyList",
        "NSUserNotificationUsageDescription": "FiftyList uses notifications to remind you to share your reading and watching progress, and to celebrate your milestones."
      }
    },
    "android": {
      "package": "com.chrisgunn.fiftylist",
      "versionCode": 23,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#D6B588"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#D6B588"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "342e8c02-6906-49e2-b4ab-85056efbf2aa"
      }
    }
  }
}
